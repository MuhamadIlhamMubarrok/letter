    public function test_home_page_renders_with_editorial_hero_and_bestsellers(): void
    {
        $response = $this->get('/');

        $response->assertStatus(200);
        $response->assertSee('maja flower');
        $response->assertSee('Ungkapkan Cerita Lewat');
        $response->assertSee('Lumière Series - Sunshine');
        $response->assertSee('The Language of Flowers');
        $response->assertSee('Bespoke Custom');
        $response->assertSee('Instagram');
        $response->assertSee('TikTok');
        $response->assertSee('Facebook');
        $response->assertSee('Threads');
    }

    public function test_catalog_page_renders_with_filters(): void
    {
        $response = $this->get('/katalog');

        $response->assertStatus(200);
        $response->assertSee('Katalog Rangkaian Bunga');
        $response->assertSee('Teddy Series');
        $response->assertSee('Lumière Series');
        $response->assertSee('Filter Katalog');

        // Test category route redirection
        $catResponse = $this->get('/kategori/teddy-series');
        $catResponse->assertRedirect('/katalog?category=teddy-series');

        // Test catalog filter with category slug
        $filteredResponse = $this->get('/katalog?category=teddy-series');
        $filteredResponse->assertStatus(200);
        $filteredResponse->assertSee('Teddy Series - Rose Big Size');
    }

    public function test_product_detail_page_shows_customization_and_whatsapp_generator(): void
    {
        $product = Product::first();
        $this->assertNotNull($product);

        $response = $this->get('/katalog/' . $product->slug);

        $response->assertStatus(200);
        $response->assertSee($product->name);
        $response->assertSee('Personalisasi Buket Anda');
        $response->assertSee('Pilihan Warna Kertas Wrapping');
        $response->assertSee('Pesan Sekarang via WhatsApp');
    }

    public function test_order_tracking_page_renders_and_tracks_order_with_privacy_protection(): void
    {
        $response = $this->get('/lacak-pesanan');
        $response->assertStatus(200);
        $response->assertSee('Lacak Perjalanan Buket Bunga');
        // Ensure no demo shortcut buttons exist that expose real customer orders
        $response->assertDontSee('Coba Resi Demo:');

        // Track specific Buckflow order seeded from DatabaseSeeder
        $order = Order::where('tracking_code', 'BF-202610-0001')->firstOrFail();

        $trackResponse = $this->get('/lacak-pesanan?code=' . $order->tracking_code);
        $trackResponse->assertStatus(200);
        $trackResponse->assertSee($order->tracking_code);
        $trackResponse->assertSee('Quality Control & Approval Foto Buket', false);
        $trackResponse->assertSee('Setujui Rangkaian');

        // Verify privacy masking: customer personal data is masked
        $trackResponse->assertSee($order->masked_customer_name);
        $trackResponse->assertSee($order->masked_customer_phone);
        $trackResponse->assertDontSee('081234567891'); // Raw phone number must NOT be visible
        $trackResponse->assertSee('Enkripsi Privasi Aktif');
    }

    public function test_customer_can_approve_bouquet_photo(): void
    {
        $order = Order::where('tracking_code', 'BF-202610-0001')->firstOrFail();

        $response = $this->post("/lacak-pesanan/{$order->tracking_code}/approval", [
            'action' => 'APPROVE',
        ]);

        $response->assertRedirect('/lacak-pesanan?code=' . $order->tracking_code);

        $order->refresh();
        $this->assertEquals('APPROVED', $order->customer_approval_status);
        $this->assertStringContainsString('Approval Customer: Disetujui', (string) $order->notes);
    }

    public function test_chatbot_endpoint_returns_intelligent_floral_response(): void
    {
        config(['services.gemini.key' => '']);
        $response = $this->postJson('/api/chatbot/ask', [
            'message' => 'Rekomendasi buket wisuda di bawah 200rb',
        ]);

        $response->assertStatus(200);
        $response->assertJsonStructure(['reply', 'timestamp', 'is_live_ai', 'model']);
        $this->assertStringContainsString('wisuda', strtolower($response->json('reply')));

        $customResponse = $this->postJson('/api/chatbot/ask', [
            'message' => 'Bagaimana alur pemesanan custom buket?',
        ]);
        $reply = strtolower($customResponse->json('reply'));
        $this->assertTrue(
            str_contains($reply, '7 tahap') || str_contains($reply, '7 langkah') || str_contains($reply, 'konsultasi'),
            'Response should describe custom bouquet workflow.'
        );
        $this->assertTrue(
            str_contains($reply, 'resi') || str_contains($reply, 'preview') || str_contains($reply, 'whatsapp'),
            'Response should include monitoring or contact info.'
        );

        // Test multi-turn conversation history
        $multiTurnResponse = $this->postJson('/api/chatbot/ask', [
            'message' => 'Berapa harganya?',
            'history' => [
                ['role' => 'user', 'content' => 'Saya tertarik buket wisuda'],
                ['role' => 'model', 'content' => 'Kami merekomendasikan Lumière Sunshine dan Teddy Series!'],
            ],
        ]);
        $multiTurnResponse->assertStatus(200);
        $this->assertNotEmpty($multiTurnResponse->json('reply'));

        // Test Live Gemini API integration with Http::fake
        config(['services.gemini.key' => 'fake-gemini-key-for-test']);
        \Illuminate\Support\Facades\Http::fake([
            'https://generativelanguage.googleapis.com/*' => \Illuminate\Support\Facades\Http::response([
                'candidates' => [
                    [
                        'content' => [
                            'parts' => [
                                ['text' => 'Halo! Ini adalah jawaban interaktif langsung dari Gemini AI Maja Assistant 🌸'],
                            ],
                            'role' => 'model',
                        ],
                    ],
                ],
            ], 200),
        ]);

        $geminiResponse = $this->postJson('/api/chatbot/ask', [
            'message' => 'Halo AI, tolong buatkan puisi buket bunga',
        ]);
        $geminiResponse->assertStatus(200);
        $this->assertTrue($geminiResponse->json('is_live_ai'));
        $this->assertStringContainsString('Gemini AI Maja Assistant', $geminiResponse->json('reply'));
    }

    public function test_admin_authentication_and_dashboard_access(): void
    {
        // Unauthenticated access redirects to secret login URL
        $guestResponse = $this->get('/admin/dashboard');
        $guestResponse->assertRedirect(route('login'));

        // Login as admin via secret route
        $loginResponse = $this->post(route('admin.login.submit'), [
            'email' => 'admin@majaflower.com',
            'password' => 'password',
        ]);
        $loginResponse->assertRedirect('/admin/dashboard');

        $admin = User::where('email', 'admin@majaflower.com')->first();
        $this->assertAuthenticatedAs($admin);

        // Dashboard renders
        $dashboardResponse = $this->actingAs($admin)->get('/admin/dashboard');
        $dashboardResponse->assertStatus(200);
        $dashboardResponse->assertSee('Ringkasan Studio');
        $dashboardResponse->assertSee('Pesanan Terbaru');
    }

    public function test_admin_orders_are_managed_via_buckflow_erp_integration(): void
    {
        $admin = User::where('email', 'admin@majaflower.com')->first();

        // 1. Internal CMS order routes are decommissioned (404)
        $this->actingAs($admin)->get('/admin/orders')->assertStatus(404);
        $this->actingAs($admin)->get('/admin/orders/create')->assertStatus(404);

        // 2. Dashboard renders Buckflow ERP live sync section
        $dashboardResponse = $this->actingAs($admin)->get('/admin/dashboard');
        $dashboardResponse->assertStatus(200);
        $dashboardResponse->assertSee('Ringkasan Studio');
        $dashboardResponse->assertSee('Buckflow ERP Sync');
        $dashboardResponse->assertSee('Buka Buckflow ERP ↗');
    }

